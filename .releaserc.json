{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/github",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "echo '${nextRelease.version}' > VERSION && ./build.sh",
        "verifyReleaseCmd": "echo 'Version ${nextRelease.version} ready'"
      }
    ]
  ]
}