{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/git",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "echo '${nextRelease.version}' > VERSION && ./build.sh",
        "verifyReleaseCmd": "echo 'Version ${nextRelease.version} ready'"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          "dist/image-playground-cli-*.tar.gz",
          "dist/image-playground-cli-*.sha256"
        ]
      }
    ]
  ]
}